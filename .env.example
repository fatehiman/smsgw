# Copy to .env (local) or /etc/smsgw.env (server). Never commit the real file.
PORT=25464
HOST=127.0.0.1
DATABASE_URL=postgres://smsgw:CHANGE_ME@127.0.0.1:5432/smsgw

# Admin login (one level). Make the hash with: node scripts/hash-password.js "the password"
ADMIN_USER=mainadmin
ADMIN_PASS_HASH=scrypt:16384:...

# Long random string. Signs the admin session cookie.
SESSION_SECRET=CHANGE_ME_LONG_RANDOM

# Header that Apache sets to the real client IP. Only trusted when the TCP peer is loopback.
CLIENT_IP_HEADER=x-gw-client-ip
